# ==============================================================================
# Barrier Configuration Example: Advanced Multi-Screen & Percentage Layouts
# ==============================================================================
#
# This example illustrates an advanced configuration with 3 computers:
#   1. desktop1: Server machine with a single central display.
#   2. desktop2: Client workstation with multiple connected displays arranged
#                above and to the right of desktop1.
#   3. laptop:   Client laptop positioned to the left of desktop1.
#
# DESK TOPOLOGY DIAGRAM:
#
#                         +--------------------+
#                         | desktop2 (top)     |
#                         | (0, 100)%          |
#                         +--------------------+
#                         +--------------------+ +--------------------+
#                         | desktop1 (center)  | | desktop2 (right)   |
#  +--------------------+ | [Server]           | |                    |
#  | laptop (left)      | | (0, 50)%  (50, 100)% |                    |
#  |                    | +--------------------+ +--------------------+
#  +--------------------+
#
# Percentage links allow splitting a screen edge so that exiting from the top
# or bottom half of a boundary enters different physical screens or positions.
#
# (Note: If you have standalone physical monitors that can be moved or plugged
# into different computers via HDMI/DisplayPort, see "barrier.conf.example-monitors"
# for the dynamic "section: monitors" architecture.)
# ==============================================================================

section: screens
	desktop1:
		halfDuplexCapsLock = false
		halfDuplexNumLock = false
		halfDuplexScrollLock = false
		xtestIsXineramaUnaware = false
		preserveFocus = false
		switchCorners = none
		switchCornerSize = 0

	desktop2:
		halfDuplexCapsLock = false
		halfDuplexNumLock = false
		halfDuplexScrollLock = false
		xtestIsXineramaUnaware = false
		preserveFocus = false
		switchCorners = none
		switchCornerSize = 0

	laptop:
		halfDuplexCapsLock = false
		halfDuplexNumLock = false
		halfDuplexScrollLock = false
		xtestIsXineramaUnaware = false
		preserveFocus = false
		switchCorners = none
		switchCornerSize = 0
end

section: links
	# desktop1 (Center Server)
	desktop1:
		# Moving left enters the laptop
		left  = laptop

		# Moving up enters desktop2 (upper display)
		up    = desktop2

		# Moving right enters desktop2 (right display)
		right = desktop2

	# laptop (Left Client)
	laptop:
		# Moving right enters desktop1
		right = desktop1

	# desktop2 (Right and Top Client)
	desktop2:
		# Moving left from the lower half enters desktop1
		left(0, 100) = desktop1

		# Moving down from the upper screen enters desktop1
		down(0, 100) = desktop1
end

section: aliases
	# Map actual operating system hostnames to friendly logical screen names.
	# You can find the real hostname by running 'hostname' in a terminal.
	John-Smiths-MacBook.local:
		laptop

	Office-Workstation-PC:
		desktop2
end

section: options
	# Designated server host screen
	server = desktop1

	# Network configuration
	port = 24800
	address = :24800

	# Features
	enableDragDrop = true
	clipboardSharing = true
	relativeMouseMoves = false
	screenSaverSync = true
	win32KeepForeground = false

	# Security (set to true if using TLS encryption certificates)
	cryptoEnabled = false
	requireClientCertificate = false

	# Direct switch hotkeys: Jump immediately to any screen via key combination
	keystroke(Control+Alt+1) = switchToScreen(laptop)
	keystroke(Control+Alt+2) = switchToScreen(desktop1)
	keystroke(Control+Alt+3) = switchToScreen(desktop2)

	# Lock mouse cursor to the current screen (toggle switch)
	keystroke(Control+Alt+L) = lockCursorToScreen(toggle)
end
