# ==============================================================================
# Sample Barrier Configuration File
# ==============================================================================
#
# Comments begin with the '#' character and continue to the end of the line.
#
# QUICK REFERENCE FOR OTHER CONFIGURATION EXAMPLES:
#  - "barrier.conf.example-basic": Simple 3-computer side-by-side setup.
#  - "barrier.conf.example-monitors": Advanced setups with physical standalone
#    monitors, dynamic EDID hardware matching, and multi-monitor laptops.
#  - "barrier.conf.example-advanced": Multi-screen percentage links and hotkeys.
#  - "barrier.conf.example-barebones": Minimal 2-computer setup.
# ==============================================================================

section: screens
	# Three hosts named: moe, larry, and curly
	moe:
	larry:
	curly:
end

section: links
	# larry is to the right of moe, and curly is above moe
	moe:
		right = larry
		up    = curly

	# moe is to the left of larry, and curly is above larry.
	# Note that curly is above both moe and larry, and moe
	# and larry have a symmetric connection (they are in
	# opposite directions of each other).
	larry:
		left  = moe
		up    = curly

	# larry is below curly. If you move up from moe and then
	# down, you'll end up on larry.
	curly:
		down  = larry
end

section: aliases
	# curly is also known as shemp
	curly:
		shemp
end
